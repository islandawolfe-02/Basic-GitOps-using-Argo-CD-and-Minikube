# Session variables for the MacBook/minikube route: the same names the classroom environment session supplied.
# Public values only; no credentials. Load with:  source scripts/p1.env
# P1_REPO_NAMESPACE / P1_REPO_POD are not used: `git push` + a merged pull request replaces submit.sh.
export P1_NAMESPACE=p1-islandawolfe-02
export P1_SESSION=p1-islandawolfe-02-mac
export P1_IMAGE="localhost/$P1_NAMESPACE:foundation-a"
# Loki as reached from a local Docker container (needs: kubectl -n observability port-forward svc/loki 3100:3100)
export P1_LOCAL_LOKI_URL=http://host.docker.internal:3100
# Loki as reached from Pods (goes into configuration/app/resources.yaml)
export P1_CLUSTER_LOKI_URL=http://loki.observability.svc.cluster.local:3100
# Grafana (needs: kubectl -n observability port-forward svc/grafana 3000:3000)
export P1_GRAFANA_URL=http://127.0.0.1:3000/d/w110-requests

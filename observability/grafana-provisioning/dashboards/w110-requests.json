{
  "uid": "w110-requests",
  "title": "W1.10 requests",
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [
    { "name": "session", "type": "textbox", "label": "Workspace session", "query": "p1-islandawolfe-02-mac" },
    { "name": "request", "type": "textbox", "label": "Request or action ID", "query": "" }
  ] },
  "panels": [
    {
      "id": 1, "type": "logs", "title": "Completion records matching the selected ID",
      "gridPos": { "h": 20, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" },
                     "expr": "{job=\"academy-w110\", session=\"$session\"} |= \"$request\"" } ],
      "options": { "showTime": true, "wrapLogMessage": true, "prettifyLogMessage": true }
    }
  ],
  "schemaVersion": 39
}
